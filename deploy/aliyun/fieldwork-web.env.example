# 田野罗盘 Web 服务运行环境变量（模板）
# 用法：复制为 fieldwork-web.env，填入真实密钥，chmod 600，勿提交 git。
#   cp fieldwork-web.env.example fieldwork-web.env && chmod 600 fieldwork-web.env
# systemd 通过 EnvironmentFile 加载本文件（KEY=VALUE，每行一个，等号两侧不要空格）。
#
# ⚠ 至少必须填写 FIELDWORK_APP_TOKEN（生成命令见下方注释）；留空会导致服务
#   拒绝启动，这是为了不把项目读写与服务端 LLM 额度暴露给整个互联网。

# ── 百炼 / DashScope（通义千问）API Key ──────────────────────────
# Web 直访模式必填：没有它，页面对话与方案生成无法调用 LLM（app.state.llm 会是 None）。
# 纯 MCP 托管模式可留空：调用方在百炼 MCP 配置里加 x-dashscope-key Header 自带 key，
# 逐请求覆盖本值；都没有时 MCP 内 LLM 工具模板降级（零额度消耗），不影响其余工具。
# 多租户 key 归属详见 deploy/aliyun/DEPLOY.md 第 7 节。
DASHSCOPE_API_KEY=

# 可选：DashScope 兼容接口地址（一般无需改）
# DASHSCOPE_HTTP_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# ── 可选：飞猪 FlyAI Key（真实机票/火车/酒店检索工具）───────────────────
# 作用是服务器全局兜底：MCP 调用未带 x-flyai-key Header 时消耗此 key 配额
# （免费申领 5000 次 + 每日 100 次共享）。不填且调用方也没带，则旅行搜索工具
# 降级（flyai_unavailable），其余功能正常。另需服务器装有 flyai CLI（见 DEPLOY.md 第 0 节）。
FLYAI_API_KEY=

# ── 必填：应用访问令牌（S01 + 审计 F02）───────────────────────────────
# 本部署模板的服务单元对外监听（--host 0.0.0.0），且已声明
# FIELDWORK_PUBLIC_BIND=1：启动期要求本值非空，缺失则**服务拒绝启动**。
# 这是刻意的 fail-closed——旧默认是「令牌留空 = 全站开放」，服务暴露到公网后
# 等于任何人可读写他人项目、消耗服务端付费 LLM 额度。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 填好后在页面首页「API 密钥」卡填入同一令牌，否则浏览器请求会被 401 拦下。
# 仅内网裸跑才可留空，同时需注释服务单元里的 FIELDWORK_PUBLIC_BIND=1。
FIELDWORK_APP_TOKEN=

# ── 可选：模型分档（不填用代码默认值）──────────────────────────────────
# FA_INTERVIEW_MODEL=qwen3.8-flash
# FA_PROPOSAL_MODEL=qwen-max
# FA_EXTRACT_MODEL=qwen3.8-flash

# ── 可选：限流与日配额（S02）────────────────────────────────────────
# 进程内限流：当前单进程 uvicorn 成立；将来开多 worker 需换共享后端。
# 登录：次/分钟/IP 与 次/分钟/账号双维度（防单点与分布式爆破）
# FA_LOGIN_RATE_LIMIT=10
# FA_LOGIN_ACCOUNT_RATE_LIMIT=10
# 注册：次/小时/IP
# FA_REGISTER_RATE_LIMIT=20
# 回合：次/天/owner（服务器本地日期；0 = 当天全禁，应急用）
# FA_TURN_DAILY_QUOTA=200

# ── 可选：Tier S 资产目录（生产版系统提示词/访谈库）────────────────────
# 不设则回落内置 Tier P 公开版资产，功能完整、仅提示词为开源简版。
# 若把 secrets/ 上传到服务器，指向它即可启用 Tier S：
# FIELDWORK_ASSETS_DIR=/opt/fieldwork-agent/secrets

# ── 可选：日志级别（A06）──────────────────────────────────
# 应用日志走 stderr（systemd 下 journalctl -u fieldwork-web 可见），
# 回合级埋点：turn_start / llm_request / tool_call / turn_end。
# FA_LOG_LEVEL=INFO
