[Unit]
Description=Fieldwork Agent Web (田野罗盘 — FastAPI + 内置前端)
Documentation=file:///opt/fieldwork-agent/deploy/aliyun/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 单机自用直接以 root 跑最省事；如需降权，改成专用用户并同步改 HOME。
User=root
# Config/JsonRepository 用 Path.home()/.fieldwork_agent 存项目数据，显式固定 HOME 避免歧义。
Environment=HOME=/root
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/fieldwork-agent
# 缺失不报错（前缀 -）；真实密钥写在此文件，chmod 600，勿提交 git。
EnvironmentFile=-/opt/fieldwork-agent/deploy/aliyun/fieldwork-web.env
# S01：本单元对外监听（--host 0.0.0.0），故声明公网绑定——启动期强制要求
# FIELDWORK_APP_TOKEN 非空，缺失则拒绝启动（而不是默默对全网开放）。
# 确需内网裸跑时才注释本行。生成令牌：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
Environment=FIELDWORK_PUBLIC_BIND=1
# --http h11：百炼探测节点（Java 客户端）默认发 h2c 明文升级头，
# httptools 实现会拦截为 400（Unsupported upgrade request）；h11 按普通请求放行。
ExecStart=/opt/fieldwork-agent/.venv/bin/uvicorn fieldwork_agent.web_host.app:create_app --factory --http h11 --host 0.0.0.0 --port 2143
Restart=always
RestartSec=3
# 轻量服务器资源有限，给个软上限防止失控；不需要可删。
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
